<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Without these, FCM falls back to the full-color square launcher icon as the
             notification small icon, which Android renders using only its alpha channel
             (opaque everywhere here) -> a solid white square in the status bar/shade. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify"
        />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_icon_color"
        />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Backs the web frontend's navigator.geolocation calls (Panchang page).
         COARSE only, deliberately: every getCurrentPosition() call site passes
         enableHighAccuracy:false and only needs city-level precision, so FINE
         bought nothing while drawing extra Play review scrutiny and a scarier
         runtime permission dialog. Don't re-add it without a real need. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required on Android 13+ (API 33) for runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Backs the web frontend's navigator.mediaDevices.getUserMedia() call in the Palm
         Reading capture wizard. Capacitor's WebView already maps the WEBKIT
         VIDEO_CAPTURE permission request to this manifest entry
         (BridgeWebChromeClient.onPermissionRequest) — without it, getUserMedia rejects
         with NotAllowedError even if the user taps "allow" in the runtime prompt. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Not required: the capture wizard always offers a "upload a photo instead" fallback,
         so a camera-less device (or an emulator) shouldn't be excluded from the Play Store
         listing over this one feature. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Backs the web frontend's navigator.mediaDevices.getUserMedia({ audio }) call in
         realtime Voice Chat. Exactly the same Capacitor plumbing as CAMERA above: the
         WebView maps the WEBKIT AUDIO_CAPTURE permission request onto this manifest entry
         (BridgeWebChromeClient.onPermissionRequest), and without it getUserMedia rejects
         with NotAllowedError even after the user taps "allow" in the runtime prompt.
         Voice Chat ships behind a feature flag that defaults to off, so declaring this
         does not by itself expose any recording capability. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Not required, same rationale as the camera feature above: a device without a
         microphone should still be able to install the app and use everything else. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
